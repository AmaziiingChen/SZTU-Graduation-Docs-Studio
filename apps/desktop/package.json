{
  "name": "@sztu-docs/desktop",
  "private": true,
  "version": "0.1.17",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "icons:build": "node scripts/generate-icons.cjs",
    "dev": "pnpm run build:electron && concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc -b && pnpm run build:electron && vite build",
    "package:mac": "electron-builder --mac dmg zip --arm64 && node ../../scripts/verify_macos_app_bundle.mjs",
    "package:win": "electron-builder --win nsis --x64",
    "package:win:offline": "electron-builder --config electron-builder.offline.yml --win nsis --x64",
    "lint": "node --test ../../tests/frontend-component-reuse.test.mjs && node ../../scripts/check_frontend_design_system.mjs && oxlint electron src",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/react": "0.5.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@tiptap/extension-subscript": "3.30.5",
    "@tiptap/extension-superscript": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "date-fns": "^4.4.0",
    "electron": "^44.0.0",
    "electron-builder": "26.15.3",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.35.0",
    "motion": "^13.4.0",
    "next-themes": "^0.4.6",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "recharts": "3.8.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "thinking-orbs": "^0.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "unified": "^11.0.5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}

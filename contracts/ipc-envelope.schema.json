{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sztu-docs.local/contracts/ipc-envelope.schema.json",
  "title": "SZTU Graduation Docs Studio JSONL IPC envelope",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/successResponse"},
    {"$ref": "#/$defs/errorResponse"},
    {"$ref": "#/$defs/progressNotification"}
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "id", "method"],
      "properties": {
        "protocol": {"const": "1.0"},
        "id": {"$ref": "#/$defs/identifier"},
        "method": {"type": "string", "minLength": 1, "maxLength": 128},
        "params": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"method": {"const": "workspace.listDocuments"}}},
          "then": {
            "required": ["params"],
            "properties": {"params": {"$ref": "#/$defs/workspaceListDocumentsParams"}}
          }
        }
      ]
    },
    "documentListCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["updated_at", "id"],
      "properties": {
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "id": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
      }
    },
    "workspaceListDocumentsParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "deleted"],
      "properties": {
        "profile_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "deleted": {"type": "boolean"},
        "cursor": {"oneOf": [{"$ref": "#/$defs/documentListCursor"}, {"type": "null"}]},
        "limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 100}
      }
    },
    "cancelParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id"],
      "properties": {
        "request_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "progressNotification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "event", "request_id", "progress"],
      "properties": {
        "protocol": {"const": "1.0"},
        "event": {"const": "request.progress"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["current", "total", "message"],
          "properties": {
            "current": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 1},
            "message": {"type": "string", "minLength": 1, "maxLength": 500},
            "stage": {"type": "string", "minLength": 1, "maxLength": 100}
          }
        }
      }
    },
    "successResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "id", "ok", "result"],
      "properties": {
        "protocol": {"const": "1.0"},
        "id": {"$ref": "#/$defs/identifier"},
        "ok": {"const": true},
        "result": {}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_JSON",
            "INVALID_REQUEST",
            "MESSAGE_TOO_LARGE",
            "DUPLICATE_REQUEST_ID",
            "METHOD_NOT_FOUND",
            "INVALID_PARAMS",
            "INTERNAL_ERROR",
            "WORKSPACE_NOT_OPEN",
            "WORKSPACE_ALREADY_OPEN",
            "REQUEST_CANCELLED",
            "REQUEST_NOT_CANCELLABLE",
            "CONTRACT_VERSION_TOO_NEW",
            "CONTRACT_VERSION_UNSUPPORTED",
            "CONTRACT_MIGRATION_FAILED",
            "TEMPLATE_NOT_FOUND",
            "TEMPLATE_UNTRUSTED",
            "PATH_INVALID",
            "HASH_MISMATCH",
            "EXPORT_FAILED",
            "SINGLE_PAGE_OVERFLOW",
            "NOT_FOUND",
            "REVISION_CONFLICT",
            "VALIDATION",
            "MIGRATION_FAILED",
            "STORAGE_ERROR"
          ]
        },
        "message": {"type": "string", "minLength": 1},
        "details": {"type": "object"}
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "id", "ok", "error"],
      "properties": {
        "protocol": {"const": "1.0"},
        "id": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "ok": {"const": false},
        "error": {"$ref": "#/$defs/error"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sztu-docs.local/contracts/export-request.schema.json",
  "title": "Validated document export request",
  "description": "Unlike document-draft, the embedded document must satisfy its strict process-document contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "draft_id", "document", "template", "formats", "output_directory", "input_sha256", "requested_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "draft_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "document": {
      "oneOf": [
        {"$ref": "proposal.schema.json"},
        {"$ref": "midterm.schema.json"},
        {"$ref": "task-book.schema.json"},
        {"$ref": "assessment-form.schema.json"}
      ]
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_id", "version", "pack_sha256"],
      "properties": {
        "template_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "pack_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["docx", "tex", "pdf"]}
    },
    "output_directory": {"type": "string", "minLength": 1, "maxLength": 4096},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "requested_at": {"type": "string", "format": "date-time"}
  }
}

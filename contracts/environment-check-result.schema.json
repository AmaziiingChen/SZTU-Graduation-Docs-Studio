{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sztu-docs.local/contracts/environment-check-result.schema.json",
  "title": "Local environment status",
  "type": "object",
  "additionalProperties": false,
  "required": ["ready", "platform", "checks"],
  "properties": {
    "ready": {"type": "boolean"},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "release", "machine", "python"],
      "properties": {
        "system": {"type": "string"},
        "release": {"type": "string"},
        "machine": {"type": "string"},
        "python": {"type": "string"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "status", "message"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "status": {"enum": ["pass", "warn", "fail"]},
          "message": {"type": "string", "minLength": 1},
          "details": {"type": "object"}
        }
      }
    }
  }
}

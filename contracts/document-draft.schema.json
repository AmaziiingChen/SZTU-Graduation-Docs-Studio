{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sztu-docs.local/contracts/document-draft.schema.json",
  "title": "Incomplete process-document draft",
  "description": "Persistence contract for a work in progress. Passing this schema never means the document is export-ready.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "draft_id", "document_type", "document_schema", "payload", "state", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "draft_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "profile_id": {"type": ["string", "null"], "maxLength": 128},
    "document_type": {"enum": ["proposal", "midterm", "task_book", "advisor_review", "reviewer_review", "defense_record", "grade_assessment"]},
    "document_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"enum": ["proposal", "midterm", "task_book", "advisor_review", "reviewer_review", "defense_record", "grade_assessment"]},
        "version": {"enum": ["0.1", "0.2"]}
      }
    },
    "template": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["template_id", "version"],
      "properties": {
        "template_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "payload": {"type": "object"},
    "state": {"enum": ["draft", "ready", "archived"]},
    "revision": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"document_type": {"const": "proposal"}}},
      "then": {
        "properties": {
          "document_schema": {
            "properties": {"id": {"const": "proposal"}, "version": {"const": "0.2"}}
          },
          "payload": {"$ref": "#/$defs/incompleteProposal"}
        }
      }
    },
    {
      "if": {"properties": {"document_type": {"const": "midterm"}}},
      "then": {
        "properties": {
          "document_schema": {
            "properties": {"id": {"const": "midterm"}, "version": {"const": "0.1"}}
          },
          "payload": {"$ref": "#/$defs/incompleteMidterm"}
        }
      }
    },
    {
      "if": {"properties": {"document_type": {"const": "task_book"}}},
      "then": {
        "properties": {
          "document_schema": {
            "properties": {"id": {"const": "task_book"}, "version": {"const": "0.1"}}
          },
          "payload": {"$ref": "#/$defs/incompleteTaskBook"}
        }
      }
    },
    {"if": {"properties": {"document_type": {"const": "advisor_review"}}}, "then": {"properties": {"document_schema": {"properties": {"id": {"const": "advisor_review"}, "version": {"const": "0.1"}}}, "payload": {"$ref": "#/$defs/incompleteAssessment"}}}},
    {"if": {"properties": {"document_type": {"const": "reviewer_review"}}}, "then": {"properties": {"document_schema": {"properties": {"id": {"const": "reviewer_review"}, "version": {"const": "0.1"}}}, "payload": {"$ref": "#/$defs/incompleteAssessment"}}}},
    {"if": {"properties": {"document_type": {"const": "defense_record"}}}, "then": {"properties": {"document_schema": {"properties": {"id": {"const": "defense_record"}, "version": {"const": "0.1"}}}, "payload": {"$ref": "#/$defs/incompleteAssessment"}}}},
    {"if": {"properties": {"document_type": {"const": "grade_assessment"}}}, "then": {"properties": {"document_schema": {"properties": {"id": {"const": "grade_assessment"}, "version": {"const": "0.1"}}}, "payload": {"$ref": "#/$defs/incompleteAssessment"}}}}
  ],
  "$defs": {
    "incompleteAssessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "title": {
              "$ref": "#/$defs/paragraph"
            },
            "student_name": {
              "type": "string",
              "maxLength": 240
            },
            "student_id": {
              "type": "string",
              "maxLength": 240
            },
            "college": {
              "type": "string",
              "maxLength": 240
            },
            "major": {
              "type": "string",
              "maxLength": 240
            },
            "advisor": {
              "type": "string",
              "maxLength": 240
            },
            "advisor_title": {
              "type": "string",
              "maxLength": 240
            },
            "reviewer": {
              "type": "string",
              "maxLength": 240
            },
            "reviewer_title": {
              "type": "string",
              "maxLength": 240
            },
            "defense_time": {
              "type": "string",
              "maxLength": 240
            },
            "defense_location": {
              "type": "string",
              "maxLength": 240
            },
            "recorder": {
              "type": "string",
              "maxLength": 240
            },
            "leader": {
              "type": "string",
              "maxLength": 240
            }
          }
        },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "comments": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/textContentBlock"
              }
            },
            "division_of_work": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/textContentBlock"
              }
            },
            "suggested_grade": {
              "type": "string",
              "maxLength": 50
            },
            "final_grade": {
              "type": "string",
              "maxLength": 50
            },
            "date": {
              "type": "string",
              "maxLength": 50
            },
            "members": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "string",
                "maxLength": 80
              }
            },
            "questions": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "question",
                  "answer"
                ],
                "properties": {
                  "question": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "$ref": "#/$defs/textContentBlock"
                    }
                  },
                  "answer": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "$ref": "#/$defs/textContentBlock"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "text": {"type": "string", "maxLength": 5000},
    "richParagraph": {
      "$ref": "content-block.schema.json#/$defs/richParagraph"
    },
    "draftRichParagraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs"],
      "properties": {
        "type": {"const": "paragraph"},
        "runs": {
          "type": "array",
          "maxItems": 100,
          "items": {"oneOf": [{"$ref": "content-block.schema.json#/$defs/run"}, {"$ref": "content-block.schema.json#/$defs/inlineEquation"}]}
        }
      }
    },
    "paragraph": {
      "oneOf": [
        {"type": "string", "maxLength": 5000},
        {"$ref": "#/$defs/draftRichParagraph"}
      ]
    },
    "draftOutlineItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {"type": "integer", "minimum": 1, "maximum": 6},
        "number": {"type": "string", "maxLength": 20},
        "title": {"$ref": "#/$defs/paragraph"}
      }
    },
    "draftScheduleEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "period": {"type": "string", "maxLength": 50},
        "content": {
          "oneOf": [
            {"type": "string", "maxLength": 1500},
            {"$ref": "#/$defs/draftRichParagraph"}
          ]
        }
      }
    },
    "draftListLevel4": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {"enum": ["ordered_list", "unordered_list"]},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["content"],
            "properties": {
              "marker": {"type": "string", "minLength": 1, "maxLength": 20},
              "content": {"$ref": "#/$defs/paragraph"}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "unordered_list"}}},
          "then": {"properties": {"items": {"items": {"not": {"required": ["marker"]}}}}}
        }
      ]
    },
    "draftListLevel3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {"enum": ["ordered_list", "unordered_list"]},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["content"],
            "properties": {
              "marker": {"type": "string", "minLength": 1, "maxLength": 20},
              "content": {"$ref": "#/$defs/paragraph"},
              "children": {"$ref": "#/$defs/draftListLevel4"}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "unordered_list"}}},
          "then": {"properties": {"items": {"items": {"not": {"required": ["marker"]}}}}}
        }
      ]
    },
    "draftListLevel2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {"enum": ["ordered_list", "unordered_list"]},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["content"],
            "properties": {
              "marker": {"type": "string", "minLength": 1, "maxLength": 20},
              "content": {"$ref": "#/$defs/paragraph"},
              "children": {"$ref": "#/$defs/draftListLevel3"}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "unordered_list"}}},
          "then": {"properties": {"items": {"items": {"not": {"required": ["marker"]}}}}}
        }
      ]
    },
    "draftListLevel1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {"enum": ["ordered_list", "unordered_list"]},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["content"],
            "properties": {
              "marker": {"type": "string", "minLength": 1, "maxLength": 20},
              "content": {"$ref": "#/$defs/paragraph"},
              "children": {"$ref": "#/$defs/draftListLevel2"}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "unordered_list"}}},
          "then": {"properties": {"items": {"items": {"not": {"required": ["marker"]}}}}}
        }
      ]
    },
    "textContentBlock": {
      "oneOf": [
        {"$ref": "#/$defs/paragraph"},
        {"$ref": "#/$defs/draftListLevel1"},
        {"$ref": "content-block.schema.json#/$defs/equation"}
      ]
    },
    "paragraphs": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/paragraph"}
    },
    "textContentBlocks": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/textContentBlock"}
    },
    "editorState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bibliography"],
      "properties": {
        "bibliography": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_format", "source_text", "parse_status", "entry_count"],
          "properties": {
            "source_format": {"const": "bibtex"},
            "source_text": {"type": "string", "minLength": 1, "maxLength": 500000},
            "parse_status": {"enum": ["valid", "invalid"]},
            "entry_count": {"type": "integer", "minimum": 0, "maximum": 100}
          }
        }
      }
    },
    "incompleteProposal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "editor_state": {
          "allOf": [
            {"$ref": "#/$defs/editorState"},
            {
              "properties": {
                "bibliography": {
                  "properties": {"entry_count": {"maximum": 50}}
                }
              }
            }
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "oneOf": [
                {"type": "string", "maxLength": 80},
                {"$ref": "#/$defs/richParagraph"}
              ]
            },
            "student_name": {"type": "string", "maxLength": 20},
            "student_id": {"type": "string", "maxLength": 30},
            "major": {"type": "string", "maxLength": 40},
            "college": {"type": "string", "maxLength": 50},
            "advisor": {"type": "string", "maxLength": 30}
          }
        },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "significance_and_status": {"$ref": "#/$defs/paragraphs", "maxItems": 50},
            "research_content_intro": {"type": "string", "maxLength": 200, "pattern": "^[^\\r\\n]*$"},
            "research_content": {"$ref": "#/$defs/textContentBlocks", "maxItems": 50},
            "methods_and_means_intro": {"type": "string", "maxLength": 200, "pattern": "^[^\\r\\n]*$"},
            "methods_and_means": {"$ref": "#/$defs/textContentBlocks", "maxItems": 50},
            "research_steps_intro": {"type": "string", "maxLength": 200, "pattern": "^[^\\r\\n]*$"},
            "research_steps": {"$ref": "#/$defs/textContentBlocks", "maxItems": 50},
            "references": {"$ref": "#/$defs/paragraphs", "maxItems": 50}
          }
        }
      }
    },
    "incompleteMidterm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {"type": ["string", "object"]},
            "student_name": {"$ref": "#/$defs/text"},
            "college": {"$ref": "#/$defs/text"},
            "major": {"$ref": "#/$defs/text"},
            "class_name": {"$ref": "#/$defs/text"},
            "advisor": {"$ref": "#/$defs/text"},
            "check_date": {"type": "string", "maxLength": 10}
          }
        },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "numbering_style": {
              "enum": [
                "chinese_hierarchy",
                "chapter_hierarchy",
                "chapter_section_hierarchy",
                "part_chapter_section_hierarchy",
                "decimal_hierarchy"
              ]
            },
            "directory": {
              "type": "array",
              "maxItems": 150,
              "items": {"$ref": "#/$defs/draftOutlineItem"}
            },
            "main_research_content": {"$ref": "#/$defs/textContentBlocks", "maxItems": 80},
            "progress": {"$ref": "#/$defs/textContentBlocks", "maxItems": 80}
          }
        }
      }
    },
    "incompleteTaskBook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "editor_state": {"$ref": "#/$defs/editorState"},
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "graduation_year": {"type": ["integer", "null"], "minimum": 2000, "maximum": 2100},
            "title": {"type": ["string", "object"]},
            "student_name": {"$ref": "#/$defs/text"},
            "student_id": {"$ref": "#/$defs/text"},
            "college": {"$ref": "#/$defs/text"},
            "major": {"$ref": "#/$defs/text"},
            "class_name": {"$ref": "#/$defs/text"},
            "advisor": {"$ref": "#/$defs/text"}
          }
        },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "basic_content_and_requirements": {"$ref": "#/$defs/textContentBlocks", "maxItems": 80},
            "schedule": {
              "type": "array",
              "maxItems": 60,
              "items": {"$ref": "#/$defs/draftScheduleEntry"}
            },
            "required_materials": {"$ref": "#/$defs/textContentBlocks", "maxItems": 50},
            "references": {"$ref": "#/$defs/paragraphs", "maxItems": 100},
            "topic_information": {"type": "object"}
          }
        }
      }
    }
  }
}

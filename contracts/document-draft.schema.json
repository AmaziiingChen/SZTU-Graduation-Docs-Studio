{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sztu-docs.local/contracts/document-draft.schema.json",
  "title": "Incomplete proposal draft",
  "description": "Persistence contract for a work in progress. Passing this schema never means the document is export-ready.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "draft_id", "document_type", "document_schema", "payload", "state", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "draft_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "profile_id": {"type": ["string", "null"], "maxLength": 128},
    "document_type": {"const": "proposal"},
    "document_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "proposal"},
        "version": {"const": "0.2"}
      }
    },
    "template": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["template_id", "version"],
      "properties": {
        "template_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "payload": {"$ref": "#/$defs/incompleteProposal"},
    "state": {"enum": ["draft", "ready", "archived"]},
    "revision": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "text": {"type": "string", "maxLength": 5000},
    "paragraphs": {
      "type": "array",
      "maxItems": 50,
      "items": {"$ref": "#/$defs/text"}
    },
    "incompleteProposal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {"type": "string", "maxLength": 80},
            "student_name": {"type": "string", "maxLength": 20},
            "student_id": {"type": "string", "maxLength": 30},
            "major": {"type": "string", "maxLength": 40},
            "college": {"type": "string", "maxLength": 50},
            "advisor": {"type": "string", "maxLength": 30}
          }
        },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "significance_and_status": {"$ref": "#/$defs/paragraphs"},
            "research_content": {"$ref": "#/$defs/paragraphs"},
            "methods_and_means": {"$ref": "#/$defs/paragraphs"},
            "research_steps": {"$ref": "#/$defs/paragraphs"},
            "references": {"$ref": "#/$defs/paragraphs"}
          }
        }
      }
    }
  }
}

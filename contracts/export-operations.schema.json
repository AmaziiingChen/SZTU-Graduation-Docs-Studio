{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sztu-docs.local/contracts/export-operations.schema.json",
  "title": "Export preflight, run, cancellation, history and artifact operations",
  "$comment": "Validate method params/results against the named $defs fragment; the root intentionally exposes no generic command envelope.",
  "$defs": {
    "internalId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "format": {"enum": ["docx", "pdf", "tex"]},
    "formats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/format"}
    },
    "templateDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_id", "version", "pack_sha256"],
      "properties": {
        "template_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "pack_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "preflightParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "output_directory", "formats"],
      "properties": {
        "document_id": {"$ref": "#/$defs/internalId"},
        "output_directory": {"type": "string", "minLength": 1, "maxLength": 4096},
        "formats": {"$ref": "#/$defs/formats"}
      }
    },
    "preflightResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "ready", "document_id", "document_revision", "formats", "input_sha256", "template", "targets", "overwrite_required", "checks", "blocking_codes", "preflight_token", "expires_at"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "ready": {"const": true},
        "document_id": {"$ref": "#/$defs/internalId"},
        "document_revision": {"type": "integer", "minimum": 0},
        "formats": {"$ref": "#/$defs/formats"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "template": {"$ref": "#/$defs/templateDescriptor"},
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "filename", "path", "exists"],
            "properties": {
              "format": {"$ref": "#/$defs/format"},
              "filename": {"type": "string", "minLength": 1, "maxLength": 255},
              "path": {"type": "string", "minLength": 1, "maxLength": 4096},
              "exists": {"type": "boolean"}
            }
          }
        },
        "overwrite_required": {"type": "boolean"},
        "checks": {"type": "array", "items": {"$ref": "check-result.schema.json"}},
        "blocking_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}
        },
        "preflight_token": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "runParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "document_id", "output_directory", "formats", "preflight_token", "overwrite_confirmed", "cancellation_file", "app_version"],
      "properties": {
        "request_id": {"$ref": "#/$defs/requestId"},
        "document_id": {"$ref": "#/$defs/internalId"},
        "output_directory": {"type": "string", "minLength": 1, "maxLength": 4096},
        "formats": {"$ref": "#/$defs/formats"},
        "preflight_token": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "overwrite_confirmed": {"type": "boolean"},
        "cancellation_file": {"type": "string", "minLength": 1, "maxLength": 4096},
        "app_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}
      }
    },
    "cancelParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id"],
      "properties": {"request_id": {"$ref": "#/$defs/requestId"}}
    },
    "cancelResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "accepted", "status", "cancel_requested_at"],
      "properties": {
        "request_id": {"$ref": "#/$defs/requestId"},
        "accepted": {"type": "boolean"},
        "status": {"enum": ["cancel_requested", "not_running"]},
        "cancel_requested_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "historyParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id"],
      "properties": {
        "document_id": {"$ref": "#/$defs/internalId"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "artifactRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "format", "display_name", "sha256", "size_bytes", "file_state", "replaced_existing", "checks"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/internalId"},
        "format": {"$ref": "#/$defs/format"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 255},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "file_state": {"enum": ["available", "missing", "modified"]},
        "replaced_existing": {"type": "boolean"},
        "checks": {"type": "array", "items": {"$ref": "check-result.schema.json"}}
      }
    },
    "jobSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["export_id", "request_id", "status", "progress", "error_code", "requested_formats", "input_sha256", "template", "snapshot_available", "overwrite_confirmed", "artifacts", "created_at", "completed_at"],
      "properties": {
        "export_id": {"$ref": "#/$defs/internalId"},
        "request_id": {"oneOf": [{"$ref": "#/$defs/requestId"}, {"type": "null"}]},
        "status": {"enum": ["queued", "running", "completed", "failed", "cancelled"]},
        "progress": {"type": "integer", "minimum": 0, "maximum": 100},
        "error_code": {
          "oneOf": [
            {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
            {"type": "null"}
          ]
        },
        "requested_formats": {"$ref": "#/$defs/formats"},
        "input_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "template": {"oneOf": [{"$ref": "#/$defs/templateDescriptor"}, {"type": "null"}]},
        "snapshot_available": {"type": "boolean"},
        "overwrite_confirmed": {"type": "boolean"},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifactRecord"}},
        "created_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "historyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "history"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "history": {"type": "array", "items": {"$ref": "#/$defs/jobSummary"}}
      }
    },
    "resolveArtifactParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id"],
      "properties": {"artifact_id": {"$ref": "#/$defs/internalId"}}
    },
    "resolvedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "format", "absolute_path", "sha256", "verified"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/internalId"},
        "format": {"$ref": "#/$defs/format"},
        "absolute_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "sha256": {"$ref": "#/$defs/sha256"},
        "verified": {"const": true}
      }
    },
    "openArtifactResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "opened"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/internalId"},
        "opened": {"type": "boolean"},
        "application_error": {"type": "string", "maxLength": 500}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sztu-docs.local/contracts/update-manifest.schema.json",
  "title": "Signed desktop update manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signature"],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "channel", "version", "published_at", "artifacts"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "channel": { "const": "stable" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "published_at": { "type": "string", "format": "date-time" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "arch", "url", "sha256", "size_bytes"],
            "properties": {
              "platform": { "enum": ["darwin", "win32", "linux"] },
              "arch": { "enum": ["arm64", "x64"] },
              "url": { "type": "string", "format": "uri", "pattern": "^https://" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "size_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 }
            }
          }
        }
      }
    },
    "signature": { "type": "string", "minLength": 80, "maxLength": 100 }
  }
}

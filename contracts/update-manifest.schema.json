{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sztu-docs.local/contracts/update-manifest.schema.json",
  "title": "Signed desktop update manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signature"],
  "properties": {
    "payload": {
      "oneOf": [
        { "$ref": "#/$defs/payloadV1" },
        { "$ref": "#/$defs/payloadV2" }
      ]
    },
    "signature": {
      "type": "string",
      "minLength": 80,
      "maxLength": 100
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "arch", "url", "sha256", "size_bytes"],
      "properties": {
        "platform": { "enum": ["darwin", "win32", "linux"] },
        "arch": { "enum": ["arm64", "x64"] },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "announcement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "body",
        "severity",
        "starts_at",
        "ends_at",
        "dismissible"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "severity": { "enum": ["info", "important", "critical"] },
        "starts_at": { "type": "string", "format": "date-time" },
        "ends_at": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        },
        "dismissible": { "type": "boolean" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "update_policy",
        "minimum_supported_version",
        "service_status",
        "help_url",
        "announcement"
      ],
      "properties": {
        "update_policy": { "enum": ["optional", "recommended", "required"] },
        "minimum_supported_version": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/semver" }
          ]
        },
        "service_status": { "enum": ["normal", "maintenance", "retired"] },
        "help_url": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          ]
        },
        "announcement": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/announcement" }
          ]
        }
      }
    },
    "payloadV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "channel", "version", "published_at", "artifacts"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "channel": { "const": "stable" },
        "version": { "$ref": "#/$defs/semver" },
        "published_at": { "type": "string", "format": "date-time" },
        "artifacts": {
          "allOf": [
            { "$ref": "#/$defs/artifacts" },
            { "minItems": 1 }
          ]
        }
      }
    },
    "payloadV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "channel",
        "version",
        "published_at",
        "artifacts",
        "control"
      ],
      "properties": {
        "schema_version": { "const": "2.0" },
        "channel": { "const": "stable" },
        "version": { "$ref": "#/$defs/semver" },
        "published_at": { "type": "string", "format": "date-time" },
        "artifacts": { "$ref": "#/$defs/artifacts" },
        "control": { "$ref": "#/$defs/control" }
      }
    }
  }
}

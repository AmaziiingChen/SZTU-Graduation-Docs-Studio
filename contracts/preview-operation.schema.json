{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sztu-docs/preview-operation.schema.json",
  "title": "Internal paginated preview operation",
  "type": "object",
  "required": ["request", "result"],
  "additionalProperties": false,
  "properties": {
    "request": {
      "type": "object",
      "required": ["request_id", "document_id"],
      "additionalProperties": false,
      "properties": {
        "request_id": { "type": "string", "format": "uuid" },
        "document_id": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "schema_version",
        "preview_id",
        "document_id",
        "document_revision",
        "input_sha256",
        "template",
        "pages",
        "checks",
        "generated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "1.0" },
        "preview_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "document_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "document_revision": { "type": "integer", "minimum": 1 },
        "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "template": {
          "type": "object",
          "required": ["template_id", "version", "pack_sha256"],
          "additionalProperties": false,
          "properties": {
            "template_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "pack_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {
            "type": "object",
            "required": ["page_number", "sha256", "size_bytes", "data_url"],
            "additionalProperties": false,
            "properties": {
              "page_number": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "size_bytes": { "type": "integer", "minimum": 1 },
              "data_url": { "type": "string", "pattern": "^data:image/png;base64," }
            }
          }
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "./check-result.schema.json" }
        },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sztu-docs.local/contracts/telemetry-batch.schema.json",
  "title": "Anonymous telemetry batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sent_at", "events"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "sent_at": { "type": "string", "format": "date-time" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "event_id", "installation_id", "session_id", "name", "occurred_at", "app_version", "platform", "arch", "attributes"],
        "properties": {
          "schema_version": { "const": "1.0" },
          "event_id": { "type": "string", "format": "uuid" },
          "installation_id": { "type": "string", "format": "uuid" },
          "session_id": { "type": "string", "format": "uuid" },
          "name": { "enum": ["app_started", "heartbeat", "app_stopped", "usage_event", "update_event"] },
          "occurred_at": { "type": "string", "format": "date-time" },
          "app_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
          "platform": { "enum": ["darwin", "win32", "linux"] },
          "arch": { "enum": ["arm64", "x64"] },
          "attributes": { "type": "object" }
        },
        "allOf": [
          {
            "if": { "properties": { "name": { "const": "app_started" } } },
            "then": {
              "properties": {
                "attributes": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["launch_mode"],
                  "properties": {
                    "launch_mode": { "enum": ["packaged", "development"] }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "name": { "enum": ["heartbeat", "app_stopped"] } } },
            "then": {
              "properties": {
                "attributes": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["uptime_bucket"],
                  "properties": {
                    "uptime_bucket": { "enum": ["under_5m", "5m_to_30m", "30m_to_1h", "1h_to_3h", "over_3h"] }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "name": { "const": "usage_event" } } },
            "then": {
              "properties": {
                "attributes": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["event_name", "view"],
                      "properties": {
                        "event_name": { "const": "view_opened" },
                        "view": { "enum": ["profile", "proposal", "task_book", "midterm", "inspection"] }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["event_name", "action", "document_type", "outcome"],
                      "properties": {
                        "event_name": { "const": "document_action" },
                        "action": { "enum": ["check", "preview", "template_sync", "export", "qa_record"] },
                        "document_type": { "enum": ["proposal", "task_book", "midterm"] },
                        "outcome": { "enum": ["success", "failure", "cancelled"] },
                        "error_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
                        "format_count": { "type": "integer", "minimum": 1, "maximum": 3 }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "if": { "properties": { "name": { "const": "update_event" } } },
            "then": {
              "properties": {
                "attributes": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["outcome"],
                  "properties": {
                    "outcome": { "enum": ["up_to_date", "available", "downloaded", "failed"] },
                    "target_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}

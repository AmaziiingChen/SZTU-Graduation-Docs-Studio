{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sztu-docs.local/contracts/student-profile.schema.json",
  "title": "Student profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "student", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.2"},
    "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "student": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "student_id", "college", "major"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 20},
        "student_id": {"type": "string", "minLength": 1, "maxLength": 30},
        "college": {"type": "string", "minLength": 1, "maxLength": 50},
        "major": {"type": "string", "minLength": 1, "maxLength": 40},
        "class_name": {"type": "string", "maxLength": 50},
        "graduation_cohort": {"type": "string", "maxLength": 20},
        "phone": {"type": "string", "maxLength": 30},
        "email": {"type": "string", "maxLength": 254}
      }
    },
    "advisor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "maxLength": 30},
        "advisor_title": {"type": "string", "maxLength": 100},
        "title": {
          "type": "string",
          "maxLength": 40,
          "deprecated": true,
          "description": "Legacy 1.0 field; new writers use advisor_title."
        }
      }
    },
    "thesis_title": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "maxItems": 1,
          "items": {
            "oneOf": [
              {"type": "string", "maxLength": 100},
              {"$ref": "content-block.schema.json#/$defs/richParagraph"}
            ]
          }
        }
      ]
    },
    "thesis_title_en": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "maxLength": 300}
      ]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}

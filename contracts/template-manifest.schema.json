{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sztu-docs.local/contracts/template-manifest.schema.json",
  "title": "Template pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "template_id", "school", "document_type", "academic_year", "version", "contract_versions", "renderers", "renderer_versions", "entrypoints", "qa_policy", "files", "provenance"],
  "properties": {
    "manifest_version": {"const": "1.0"},
    "template_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "school": {"type": "string", "minLength": 1, "maxLength": 200},
    "document_type": {"const": "proposal"},
    "academic_year": {"type": "integer", "minimum": 2000, "maximum": 2200},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "contract_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_contract", "document_schema"],
      "properties": {
        "app_contract": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "document_schema": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
      }
    },
    "renderers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["latex", "docx"]}
    },
    "renderer_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
      },
      "propertyNames": {"enum": ["latex", "docx"]}
    },
    "entrypoints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/safePath"},
      "propertyNames": {"enum": ["latex", "docx"]}
    },
    "qa_policy": {"$ref": "#/$defs/safePath"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "media_type", "role"],
        "properties": {
          "path": {"$ref": "#/$defs/safePath"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "media_type": {"type": "string", "minLength": 1, "maxLength": 127},
          "role": {"enum": ["entrypoint", "qa_policy", "fixture", "fixture_expectation", "notice", "support"]}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "license", "redistribution", "sources"],
      "properties": {
        "source_kind": {"enum": ["synthetic", "upstream-derived", "local-overlay"]},
        "license": {"type": "string", "minLength": 1, "maxLength": 100},
        "redistribution": {"enum": ["allowed", "restricted", "local-only"]},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description"],
            "properties": {
              "description": {"type": "string", "minLength": 1, "maxLength": 1000},
              "url": {"type": "string", "maxLength": 2048},
              "revision": {"type": "string", "maxLength": 200}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$"
    }
  }
}

{
  "name": "sztu-graduation-docs-studio",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "setup:backend": "python scripts/setup_backend_runtime.py",
    "predev": "pnpm setup:backend",
    "dev": "pnpm --filter @sztu-docs/desktop dev",
    "telemetry:dev": "pnpm --filter @sztu-docs/telemetry-admin dev",
    "telemetry:build": "pnpm --filter @sztu-docs/telemetry-admin build",
    "telemetry:test": "pnpm --filter @sztu-docs/telemetry-admin test",
    "update:manifest": "node scripts/create_update_manifest.mjs",
    "update:keygen": "node scripts/generate_update_signing_key.mjs",
    "test:update-tools": "node --test tests/update-manifest-tools.test.mjs",
    "build": "pnpm --filter @sztu-docs/desktop build",
    "build:sidecar:mac": ".venv/bin/python scripts/build_backend_sidecar.py",
    "build:icon:mac": "node scripts/generate_macos_icon.mjs",
    "build:templates:mac": ".venv/bin/python scripts/stage_macos_template_engines.py",
    "build:thesis-template": "python scripts/stage_thesis_template.py",
    "package:mac": "pnpm setup:backend && .venv/bin/python -m pip install --disable-pip-version-check -r scripts/requirements-packaging.txt && pnpm verify && pnpm build:sidecar:mac && pnpm build:templates:mac && pnpm build:icon:mac && pnpm --filter @sztu-docs/desktop package:mac",
    "package:win": "node scripts/package_windows.mjs",
    "package:win:offline": "node scripts/package_windows.mjs --offline",
    "lint": "pnpm --filter @sztu-docs/desktop lint",
    "test": "pnpm --filter @sztu-docs/desktop test",
    "test:backend": "pnpm setup:backend && python scripts/run_backend_tests.py",
    "verify": "pnpm lint && pnpm test && pnpm telemetry:test && pnpm test:update-tools && pnpm test:backend && pnpm build && pnpm telemetry:build",
    "dev:thesis": "node scripts/dev-thesis-workbench.mjs",
    "check:packaging": "node scripts/check_packaging_plan.mjs"
  }
}
